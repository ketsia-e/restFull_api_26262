{
	"info": {
		"name": "Task Management API",
		"schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
	},
	"item": [
		{
			"name": "Get all tasks",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/tasks",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks"]
				}
			}
		},
		{
			"name": "Get task by ID",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/tasks/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks", "1"]
				}
			}
		},
		{
			"name": "Get tasks by status (completed)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/tasks/status?completed=true",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks", "status"],
					"query": [{"key": "completed", "value": "true"}]
				}
			}
		},
		{
			"name": "Get tasks by status (not completed)",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/tasks/status?completed=false",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks", "status"],
					"query": [{"key": "completed", "value": "false"}]
				}
			}
		},
		{
			"name": "Get tasks by priority",
			"request": {
				"method": "GET",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/tasks/priority/HIGH",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks", "priority", "HIGH"]
				}
			}
		},
		{
			"name": "Create new task",
			"request": {
				"method": "POST",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Complete project documentation\",\n  \"description\": \"Write comprehensive API documentation\",\n  \"completed\": false,\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2024-12-31\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/tasks",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks"]
				}
			}
		},
		{
			"name": "Update task",
			"request": {
				"method": "PUT",
				"header": [{"key": "Content-Type", "value": "application/json"}],
				"body": {
					"mode": "raw",
					"raw": "{\n  \"title\": \"Complete project documentation - Updated\",\n  \"description\": \"Write comprehensive API documentation with examples\",\n  \"completed\": false,\n  \"priority\": \"HIGH\",\n  \"dueDate\": \"2024-12-30\"\n}"
				},
				"url": {
					"raw": "http://localhost:8080/api/tasks/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks", "1"]
				}
			}
		},
		{
			"name": "Mark task as completed",
			"request": {
				"method": "PATCH",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/tasks/1/complete",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks", "1", "complete"]
				}
			}
		},
		{
			"name": "Delete task",
			"request": {
				"method": "DELETE",
				"header": [],
				"url": {
					"raw": "http://localhost:8080/api/tasks/1",
					"protocol": "http",
					"host": ["localhost"],
					"port": "8080",
					"path": ["api", "tasks", "1"]
				}
			}
		}
	]
}
